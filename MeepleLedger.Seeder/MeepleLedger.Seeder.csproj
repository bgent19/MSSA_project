<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>93de1646-b3dc-4c1f-9bc8-3ebc34f364f3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry" Version="1.20.1" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.5" />
  </ItemGroup>

  <!-- S-06: import-ledger replays an export through the real domain classes and reads it with the
       app's own export code, so these files are compiled in here too (links, not copies). The
       compiled Catalog comes along: emit rewrites CatalogSeed.cs, so a seed that won't compile now
       stops the Seeder building as well; the recovery is still git checkout + re-emit. -->
  <ItemGroup>
    <Compile Include="..\MeepleLedger\Domain\*.cs" Link="Linked\Domain\%(Filename)%(Extension)" />
    <Compile Include="..\MeepleLedger\Data\CatalogSeed.cs" Link="Linked\Data\CatalogSeed.cs" />
    <Compile Include="..\MeepleLedger\Storage\MeepleDocuments.cs" Link="Linked\Storage\MeepleDocuments.cs" />
    <Compile Include="..\MeepleLedger\Storage\LedgerExport.cs" Link="Linked\Storage\LedgerExport.cs" />
  </ItemGroup>

</Project>
