{
  "version": "2.0",

  "telemetryMode": "OpenTelemetry",

  "functionTimeout": "00:05:00",

  "logging": {
    "logLevel": {
      "default": "Information",
      "Azure": "Warning",
      "Host.Results": "Information",
      "Function": "Information"
    }
  },

  "extensions": {
    "serviceBus": {
      "prefetchCount": 0,
      "maxConcurrentCalls": 4,
      "maxAutoLockRenewalDuration": "00:05:00",
      "autoCompleteMessages": true
    }
  }
}
