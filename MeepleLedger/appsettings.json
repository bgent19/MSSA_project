{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SearchIndex": {
    "Provider": "InMemory"
  },
  "Cosmos": {
    "Database": "meepleledger",
    "Container": "games"
  },
  "Postgres": {
    "EfSearch": 100,
    "MinPoolSize": 2,
    "MaxPoolSize": 20,
    "CommandTimeoutSeconds": 5,
    "PrepareStatements": true
  }
}
