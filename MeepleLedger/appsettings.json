{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SearchIndex": {
    "Provider": "InMemory"
  },
  "MeepleStore": {
    "Provider": "InMemory"
  },
  "Cosmos": {
    "Database": "meepleledger",
    "Container": "games",
    "OwnedGamesContainer": "ownedGames",
    "PlaysContainer": "plays"
  },
  "Postgres": {
    "EfSearch": 100,
    "MinPoolSize": 2,
    "MaxPoolSize": 20,
    "CommandTimeoutSeconds": 5,
    "PrepareStatements": true
  },
  "RecommendationCache": {
    "Enabled": false,
    "TtlMinutes": 60
  },
  "EventGrid": {
    "Enabled": false
  },
  "KeyVault": {
    "ReloadIntervalMinutes": 5
  },
  "AppConfig": {
    "Label": "local",
    "RefreshIntervalSeconds": 120
  },
  "FeatureManagement": {
    "Tonight": true
  },
  "AzureMonitor": {
    "SamplingRatio": 1.0
  }
}
