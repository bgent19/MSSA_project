@inject IFeatureManager FeatureManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img class="brand-mark" src="logo-mark.png" alt="" aria-hidden="true" />
            <span class="brand-name">Meeple<span>Ledger</span></span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="meeple token-red" aria-hidden="true"></span> Collection
            </NavLink>
            <NavLink class="nav-link" href="/log" Match="NavLinkMatch.All">
                <span class="meeple token-blue" aria-hidden="true"></span> Log a Play
            </NavLink>
            <NavLink class="nav-link" href="/plays" Match="NavLinkMatch.All">
                <span class="meeple token-yellow" aria-hidden="true"></span> Play Log
            </NavLink>
            <NavLink class="nav-link" href="/stats" Match="NavLinkMatch.All">
                <span class="meeple token-green" aria-hidden="true"></span> Statistics
            </NavLink>
            @if (_tonightEnabled)
            {
                <NavLink class="nav-link" href="/tonight" Match="NavLinkMatch.All">
                    <span class="meeple token-red" aria-hidden="true"></span> Tonight
                </NavLink>
            }
        </div>
    </nav>
    <p class="sidebar-foot">Rules lawyers welcome.</p>
</div>

@code {
    // The Tonight link is behind a feature flag (A-30). The layout is not interactive, so this runs
    // on every page load and every (enhanced) navigation: flip the flag in App Configuration, and the
    // link comes or goes on the next page once the app has refreshed.
    private bool _tonightEnabled;

    protected override async Task OnInitializedAsync()
    {
        _tonightEnabled = await FeatureManager.IsEnabledAsync(AppConfigKeys.TonightFeature);
    }
}
