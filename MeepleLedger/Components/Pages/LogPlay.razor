@page "/log"
@page "/plays/{Id:guid}/edit"
@rendermode InteractiveServer
@inject IMeepleStore Store
@inject NavigationManager Nav

<PageTitle>@Heading</PageTitle>

<h1>@Heading</h1>

@if (IsEditing && _editing is null)
{
    <p>No play in your log has that id. <a href="plays">Back to the Play Log</a></p>
    return;
}

@if (_game is null)
{
    <GameSearchPicker OnGameSelected="game => _game = game" />
}
else
{
    <p>
        <strong>@_game.Name</strong>
        <small class="text-muted">@_game.MinPlayers-@_game.MaxPlayers players</small>
        <button class="btn btn-link btn-sm" @onclick="() => _game = null">change</button>
    </p>
}

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Date</label>
        <input type="date"   class="form-control" @bind="_date" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Duration (minutes)</label>
        <input type="number" class="form-control" @bind="_duration" min="1"/>
    </div>
    <div class="col-md-4">
        <label class="form-label">Location</label>
        <input type="text"   class="form-control" @bind="_location"/>
    </div>
</div>

<table class="table">
    <thead><tr><th>Player</th><th>Score</th><th>Winner</th><th></th></tr></thead>
    <tbody>
        @foreach (var r in _results)
        {
            var isOwner = r == _results[0];
            <tr @key="r">
                <td><input class="form-control"               @bind="r.PlayerName" disabled="@isOwner" /></td>
                <td><input class="form-control" type="number" @bind="r.Score"                          /></td>
                <td><input class="form-check-input" type="checkbox" @bind="r.IsWinner"                 /></td>
                <td>
                    @if (!isOwner)
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _results.Remove(r)">remove</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<button class="btn btn-outline-secondary mb-3" @onclick="AddPlayer">Add player</button>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>             
}
@if(_confirmation is not null)
{
    <div class="alert alert-success">@_confirmation</div>
}

<button class="btn btn-primary mb-3" @onclick="Submit">@(IsEditing ? "Save changes" : "Log it")</button>
@if (IsEditing)
{
    <a class="btn btn-outline-secondary mb-3 ms-2" href="plays">Cancel</a>
}


@code {
    [Parameter] public Guid? Id { get; set; }

    private Play? _editing;
    private Game? _game;
    private DateTime _date = DateTime.Today;
    private int? _duration;
    private string? _location;
    private List<PlayerResult> _results = [];  // row 0 is always the owner
    private string? _error;
    private string? _confirmation;

    private bool IsEditing => Id is not null;
    private string Heading => IsEditing ? "Edit Play" : "Log a Play";

    protected override void OnParametersSet()
    {
        _editing = Id is Guid id ? Store.PlayLog.Get(id) : null;

        if (_editing is null)
            ResetForm();
        else
            LoadForm(_editing);
    }

    // Copy the results so the form edits a draft, not the play stored in the log.
    private void LoadForm(Play play)
    {
        _game = play.Game;
        _date = play.PlayedOn;
        _duration = play.DurationMinutes;
        _location = play.Location;
        _results = [.. play.Results
            .OrderByDescending(r => r.PlayerName == Store.PlayLog.OwnerName)
            .Select(r => new PlayerResult { PlayerName = r.PlayerName, Score = r.Score, IsWinner = r.IsWinner })];
    }

    private void ResetForm()
    {
        _game = null;
        _date = DateTime.Today;
        _duration = null;
        _location = null;
        _results = [ new PlayerResult { PlayerName = Store.PlayLog.OwnerName } ];
    }

    private void AddPlayer() => _results.Add(new PlayerResult { PlayerName = "" });

    private void Submit()
    {
        _error = null;
        _confirmation = null;

        if(_game is null)
        {
            _error = "Pick a game first.";
            return;
        }

        var results = _results
                     .Where(r => !string.IsNullOrWhiteSpace(r.PlayerName))
                     .ToList();

        try
        {
            if (_editing is null)
            {
                Store.PlayLog.Record(new Play(_game, _date, results, _duration, _location));
            }
            else
            {
                Store.PlayLog.Replace(new Play(_game, _date, results, _duration, _location) { Id = _editing.Id });
            }
        }
        catch (ArgumentOutOfRangeException)
        {
            _error = $"{_game.Name} seats at most {_game.MaxPlayers} players - you have {results.Count}.";
            return;
        }
        catch(InvalidOperationException ex)
        {
            _error = ex.Message;
            return;
        }

        if (_editing is not null)
        {
            Nav.NavigateTo("plays");
            return;
        }

        _confirmation = $"Logged {_game.Name} on {_date:d}.";
        ResetForm();        
    }
}
