@page "/"
@rendermode InteractiveServer
@inject IMeepleStore Store

<PageTitle>Collection</PageTitle>

<h1>Collection</h1>

<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input class="form-control"
               placeholder="Search by title or designer"
               @bind="_term"
               @bind:event="oninput" />
    </div>
    <div class="col-md-4">
        <select class="form-select" @bind="_players">
            <option value="">Any player count</option>
            @for (var n = 1; n <= 8; n++)
            {
                <option value="@n">@n players</option>
            }
        </select>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <p class="text-muted mb-0">Showing @Rows.Count of @Store.Collection.TotalGames games</p>
    <a class="btn btn-primary btn-sm" href="collection/add">Add a game</a>
</div>

@if (Rows.Count == 0)
{
    <p>No owned games match</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Designer</th>
                <th>Players</th>
                <th>Playtime</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var owned in Rows)
            {
                var game = owned.Game;
                <tr @key="game">
                    <td class="text-truncate" style="max-width: 20rem"><a href="games/@Uri.EscapeDataString(game.Name)">@game.Name</a></td>
                    <td class="text-truncate" style="max-width: 14rem">@game.Designer</td>
                    <td>@PlayerRange(game)</td>
                    <td>@game.PlaytimeMinutes min</td>
                </tr>
            }
        </tbody>
    </table>
}


@code {
    private string _term = "";
    private int? _players;

    private IReadOnlyList<OwnedGame> Rows => [.. Store.Collection.Find(_term, _players)];

    private static string PlayerRange(Game g) =>
        g.MinPlayers == g.MaxPlayers ? $"{g.MinPlayers}" : $"{g.MinPlayers}-{g.MaxPlayers}";


}