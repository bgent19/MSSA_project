@page "/plays"
@rendermode InteractiveServer
@inject IMeepleStore Store

<PageTitle>Play Log</PageTitle>

<h1>Play Log</h1>
<p class="page-lede">Every game night, every winner, every "I was one turn away."</p>

<div class="row g-2 mb-3 align-items-center">
    <div class="col-md-8">
        <select class="form-select" @bind="_gameName">
            <option value="">All games</option>
            @foreach (var game in Store.PlayLog.GamesPlayed())
            {
                <option value="@game.Name">@game.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="not-owned-only" @bind="_notOwnedOnly" />
            <label class="form-check-label" for="not-owned-only">Only games I don't own</label>
        </div>
    </div>
</div>

<p class="text-muted mb-2">@Rows.Count plays, most recent first</p>

@if (Rows.Count == 0)
{
    <p class="empty-state">No plays match. The dice are getting dusty.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Game</th>
                <th>Players</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var play in Rows)
            {
                <tr @key="play">
                    <td class="num text-nowrap">@play.PlayedOn.ToString("d")</td>
                    <td>
                        <a href="games/@Uri.EscapeDataString(play.Game.Name)">@play.Game.Name</a>
                        @if (!Store.Collection.Owns(play.Game.Name))
                        {
                            <span class="badge text-bg-warning fs-6 ms-2">not owned</span>
                        }
                    </td>
                    <td>@Player(play)</td>
                    <td class="text-end text-nowrap">
                        @if (_pendingDelete == play)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => Delete(play)">confirm delete</button>
                            <button class="btn btn-sm btn-link" @onclick="() => _pendingDelete = null">cancel</button>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="plays/@play.Id/edit">edit</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _pendingDelete = play">delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string _gameName = "";
    private bool _notOwnedOnly;
    private Play? _pendingDelete;

    private IReadOnlyList<Play> Rows
    {
        get
        {
            var game = Store.PlayLog.GamesPlayed().FirstOrDefault(g => g.Name == _gameName);
            var plays = game is null ? Store.PlayLog.RecentFirst() : Store.PlayLog.ForGame(game);

            if (_notOwnedOnly)
                plays = plays.Where(p => !Store.Collection.Owns(p.Game.Name));

            return [.. plays];
        }
    }

    private void Delete(Play play)
    {
        Store.PlayLog.Remove(play.Id);
        _pendingDelete = null;

        // Deleting the last play of the filtered game drops it from the dropdown, so clear the filter.
        if (!Store.PlayLog.GamesPlayed().Any(g => g.Name == _gameName))
            _gameName = "";
    }

    private static string Player(Play p) =>
        string.Join(", ", p.Results.Select(r => r.IsWinner ? $"{r.PlayerName} 🏆" : r.PlayerName));
}