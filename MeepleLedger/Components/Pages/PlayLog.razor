@page "/plays"
@rendermode InteractiveServer
@inject IMeepleStore Store

<PageTitle>Play Log</PageTitle>

<h1>Play Log</h1>

<p class="text-muted">@Rows.Count plays, most recent first</p>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Game</th>
            <th>Players</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var play in Rows)
        {
            <tr @key="play">
                <td>@play.PlayedOn.ToString("d")</td>
                <td>
                    @play.Game.Name
                    @if (!Store.Collection.Owns(play.Game.Name))
                    {
                        <span class="badge text-bg-warning ms-2">not owned</span>
                    }
                </td>
                <td>@Player(play)</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<Play> Rows => [.. Store.PlayLog.RecentFirst()];

    private static string Player(Play p) =>
        string.Join(", ", p.Results.Select(r => r.IsWinner ? $"{r.PlayerName} 🏆" : r.PlayerName));
}