<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Shared with MeepleLedger.Seeder, so the Cosmos and Azure OpenAI secrets set for the seeder
         are read by the app too. Only used in Development. -->
    <UserSecretsId>93de1646-b3dc-4c1f-9bc8-3ebc34f364f3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Data\" />
  </ItemGroup>

  <!-- A-08: the Cosmos DB Search Index Provider. The Cosmos SDK loads Newtonsoft.Json at runtime
       but does not depend on it, so it has to be referenced here as well. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- A-13: the PostgreSQL Search Index Provider. Npgsql is the driver; Pgvector brings the
       vector type mapping (UseVector, in the Pgvector.Npgsql namespace), so an Ask's embedding is
       sent as a real vector parameter. Same versions as MeepleLedger.Seeder. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
  </ItemGroup>

  <!-- A-16: the Recommendation cache in Azure Managed Redis. Same version as MeepleLedger.Seeder. -->
  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="3.4.5" />
  </ItemGroup>

  <!-- A-20: publishes PlayLogged to an Event Grid custom topic. -->
  <ItemGroup>
    <PackageReference Include="Azure.Messaging.EventGrid" Version="5.0.0" />
  </ItemGroup>

  <!-- A-29: secrets from Key Vault. The configuration provider reads them as settings (and reloads
       them, so a rotated key is picked up); Azure.Identity brings DefaultAzureCredential, which is
       the managed identity in Azure and the Azure CLI login on this machine. -->
  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

</Project>
